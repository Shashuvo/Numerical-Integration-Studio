/* Numerical Integration Studio — Dark Theme */

QWidget {
    background-color: #1B1D27;
    color: #E4E6F0;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #1B1D27;
}

QGroupBox {
    background-color: #232633;
    border: 1px solid #33374A;
    border-radius: 10px;
    margin-top: 14px;
    padding: 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 10px;
    color: #8CA0F0;
}

QPushButton {
    background-color: #6373D9;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #7484E0;
}

QPushButton:pressed {
    background-color: #4E5FC2;
}

QPushButton:disabled {
    background-color: #40445A;
    color: #8A8FA5;
}

QPushButton#secondaryButton {
    background-color: #232633;
    color: #8CA0F0;
    border: 1px solid #6373D9;
}

QPushButton#secondaryButton:hover {
    background-color: #2C3040;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #232633;
    border: 1px solid #33374A;
    border-radius: 6px;
    padding: 6px 8px;
    color: #E4E6F0;
    selection-background-color: #6373D9;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #8CA0F0;
}

QLineEdit#invalidInput {
    border: 1px solid #E06666;
    background-color: #33232A;
}

QLabel#errorLabel {
    color: #E06666;
    font-weight: 600;
}

QLabel#statusLabelOk {
    color: #6ED18F;
}

QTableWidget {
    background-color: #232633;
    border: 1px solid #33374A;
    border-radius: 8px;
    gridline-color: #33374A;
    color: #E4E6F0;
}

QHeaderView::section {
    background-color: #2C3040;
    color: #E4E6F0;
    padding: 6px;
    border: none;
    font-weight: 600;
}

QTabWidget::pane {
    border: 1px solid #33374A;
    border-radius: 8px;
    background-color: #232633;
}

QTabBar::tab {
    background-color: #2C3040;
    color: #B8BCD0;
    padding: 8px 16px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #232633;
    color: #8CA0F0;
    font-weight: 600;
}

QStatusBar {
    background-color: #232633;
    border-top: 1px solid #33374A;
}

QMenuBar, QMenu {
    background-color: #232633;
    color: #E4E6F0;
}

QMenu::item:selected {
    background-color: #2C3040;
}

QToolBar {
    background-color: #232633;
    border-bottom: 1px solid #33374A;
    spacing: 6px;
}

QProgressBar {
    border: 1px solid #33374A;
    border-radius: 6px;
    text-align: center;
    background-color: #232633;
    color: #E4E6F0;
}

QProgressBar::chunk {
    background-color: #6373D9;
    border-radius: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #565B75;
    background-color: #232633;
}

QCheckBox::indicator:checked {
    background-color: #6373D9;
    border: 1px solid #6373D9;
}
